CODE_COMIC_LLM_PROVIDER=openai
# Comma-separated list; first item is the default. Single-item lists are fine.
CODE_COMIC_LLM_MODELS=gemini,openai/gpt-4-0613
# Hugging Face first, Gemini second (auto-fallback when HF fails).
CODE_COMIC_IMAGE_MODELS=black-forest-labs/FLUX.1-schnell,gemini-2.5-flash-image
CODE_COMIC_OUTPUT_DIR=output
HF_TOKEN=your_huggingface_token_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
