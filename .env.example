CODE_COMIC_LLM_PROVIDER=openai
# Comma-separated list; first item is the default. Single-item lists are fine.
CODE_COMIC_LLM_MODELS=gemini,openai/gpt-4-0613
CODE_COMIC_IMAGE_PROVIDER=stablediffusion
# Use Gemini image model by default for free-tier users.
CODE_COMIC_IMAGE_MODELS=gemini-2.5-flash-image,stability-ai/stable-diffusion
CODE_COMIC_OUTPUT_DIR=output
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here