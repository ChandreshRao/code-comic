# Setup guide: docs/SETUP.md
# Gemini key: https://aistudio.google.com/app/apikey
# Hugging Face token: https://huggingface.co/settings/tokens

# Comma-separated list; first item is primary, rest are fallbacks on API failure.
CODE_COMIC_LLM_MODELS=gemini,meta-llama/Meta-Llama-3-8B-Instruct
# Hugging Face first, Gemini second (auto-fallback when HF fails).
CODE_COMIC_IMAGE_MODELS=black-forest-labs/FLUX.1-schnell,gemini-2.5-flash-image

# Required for default LLM (html-mermaid) and image fallback (html-image).
GEMINI_API_KEY=your_gemini_api_key_here
# Required for html-image mode (primary image provider).
HF_TOKEN=your_huggingface_token_here
# Optional — only if you configure OpenAI models.
OPENAI_API_KEY=your_openai_api_key_here
# Render mode: html-mermaid (default) or html-image
# CODE_COMIC_RENDER_MODE=html-mermaid
# MCP server logging (stderr): DEBUG, INFO, WARNING, ERROR
# CODE_COMIC_LOG_LEVEL=INFO
# CODE_COMIC_DEBUG=1

# Optional — Foundry IQ (Azure AI Search knowledge base retrieve URL + api-key).
# See docs/FOUNDRY_IQ.md. Not required for the submission demo.
# FOUNDRY_IQ_ENDPOINT=https://<service>.search.windows.net/knowledgebases('<kb>')/retrieve?api-version=2026-04-01
# FOUNDRY_IQ_API_KEY=your_search_api_key_here
# FOUNDRY_IQ_TIMEOUT=10
